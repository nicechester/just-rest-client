{
  "name": "just-rest-client",
  "version": "1.1.5",
  "description": "A lightweight REST API client built with Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && tauri build",
    "clean": "npm run clean:frontend && npm run clean:rust",
    "clean:frontend": "rm -rf dist",
    "clean:rust": "cd src-tauri && cargo clean",
    "clean:all": "npm run clean && rm -rf node_modules"
  },
  "keywords": [
    "rest",
    "api",
    "client",
    "http",
    "tauri"
  ],
  "author": "Chester Kim",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "vanilla-jsoneditor": "^3.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "vite": "^7.2.6"
  }
}
